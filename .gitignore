# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
devtools_options.yaml
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local scratch workspace. Holds the standalone web player demo and the
# screenshots taken while verifying the Flutter UI — deliberately not tracked.
/demo/

# CodeGraph local index (per-machine, rebuilt by `codegraph init`).
/.codegraph/
/codegraph.json

# Rust build artifacts. The backend is a standalone crate, so it gets its own
# `target/` rather than sharing the bridge crate's.
/rust/target/
/rust/backend/target/

# Writable mirror of the read-only Flutter SDK used by this environment.
/.flutter-overlay/

# Writable CARGO_HOME used to install the FRB codegen (read-only ~/.cargo).
/.cargo-home/

# Local agent scratch memory — per-machine notes, not part of the project.
/.workbuddy-ai/
